{{!
    @template block_oksigeniaayvurenda/content

    The library on the personal area, inside the theme's own block frame: for each centre, what it tells today (the
    memory's idea, the book of the week or what just came) or the reader's books with when they go back, then the class
    challenge, their own goal, the readings of their courses or what waits at the desk, and the way in. Gaudí's mock-up
    of 7 November 2026 (block 0.2.0).

    Context variables required for this template:
    * desk - what waits at the desk: one library with its numbers (one), or several a row each (many)
    * centres - one per centre: name, showname, skin, home and sections
    * sections - each with one of books, tell, challenge, goal, readings, moments (what there is to celebrate) or pulse
      (the library this week, for whoever runs it), and first and extra
    * skin, home, golabel, gofirst, card, cardlabel, leaf, star - the ways in, once, at the end

    Example context (json):
    {
        "desk": null, "skin": "school", "home": "https://example.com/index.php", "golabel": "Ir a la biblioteca",
        "gofirst": true, "card": "https://example.com/card.php", "cardlabel": "Mi carné", "leaf": true, "star": false,
        "centres": [{
            "name": "Biblioteca", "showname": false, "skin": "school", "home": "https://example.com/index.php",
            "sections": [
                {"first": true, "extra": false, "tell": {"face": "https://example.com/memoria.webp", "heading": "La idea de hoy",
                    "line": "Como te encantó «Pepa y el volcán», creo que este también te va a gustar.",
                    "pick": {"cover": {"img": "https://example.com/cover.jpg", "drawn": "dc-green", "title": "Mapas de mar"},
                        "title": "Mapas de mar", "author": "Javier Molina", "url": "https://example.com/record.php",
                        "state": "Libre, en su estantería", "ok": true, "label": "Ver el libro"},
                    "search": null, "shelf": null, "sign": ""} },
                {"first": false, "extra": false, "challenge": {"heading": "El reto de tu clase", "count": "4 de 6",
                    "marks": [{"on": true}, {"on": false}], "stars": false, "text": "Libros de seis rincones distintos, entre todos",
                    "meton": ""} },
                {"first": false, "extra": false, "moments": {"heading": "Para celebrar", "face": "https://example.com/mainumby.webp",
                    "items": [{"text": "Este curso ya van 1.000 libros prestados.", "url": "https://example.com/record.php"},
                        {"text": "La clase 3.º B ha cumplido su reto.", "url": ""}]} }
            ]
        }]
    }
}}
<div class="block-oksigeniaayvurenda">
{{#desk}}
<div class="ayvb skin-{{skin}}" data-ayvb>
    <section class="ayvb-sec">
        <h3 class="ayvb-h">{{heading}}</h3>
        {{#one}}
        {{#uptodate}}<p class="ayvb-small">{{uptodate}}</p>{{/uptodate}}
        <ul class="ayvb-counts">
            {{#rows}}<li{{#late}} class="late"{{/late}}><a href="{{url}}"><b>{{number}}</b><span>{{label}}</span></a></li>{{/rows}}
        </ul>
        <a class="btn ayvb-btn" href="{{desk}}">{{desklabel}}</a>
        {{/one}}
        {{#hasmany}}
        <ul class="ayvb-desks">
            {{#many}}<li><div><a class="ayvb-title" href="{{home}}">{{name}}</a><span class="ayvb-small{{#late}} late{{/late}}">{{summary}}</span></div><a class="btn ayvb-btn ayvb-btn-sm" href="{{desk}}">{{desklabel}}</a></li>{{/many}}
        </ul>
        {{/hasmany}}
    </section>
</div>
{{/desk}}
{{#centres}}
<div class="ayvb skin-{{skin}}" data-ayvb>
    {{#showname}}<p class="ayvb-name"><a href="{{home}}">{{name}}</a></p>{{/showname}}
    {{#sections}}
    <section class="ayvb-sec{{#extra}} ayvb-extra{{/extra}}">
        {{#books}}
        <h3 class="ayvb-h">{{heading}}{{#count}}<span class="ayvb-count"><span aria-hidden="true">{{count}}</span><span class="ayvb-sr">{{countlabel}}</span></span>{{/count}}</h3>
        {{#notice}}<p class="ayvb-due late">{{notice}}</p>{{/notice}}
        {{#hasitems}}
        <ul class="ayvb-books">
            {{#items}}
            <li class="ayvb-book">
                {{#cover}}{{#img}}<span class="ayvb-cover sm"><img src="{{img}}" alt=""></span>{{/img}}{{^img}}<span class="ayvb-cover sm drawn {{drawn}}"><i>{{title}}</i></span>{{/img}}{{/cover}}
                <div>
                    <a class="ayvb-title" href="{{url}}">{{title}}</a>
                    {{#late}}<p class="ayvb-due late" title="{{datetitle}}">{{late}}</p>{{/late}}
                    {{#ready}}<p class="ayvb-due ready">{{ready}}</p>{{/ready}}
                    {{#waiting}}<p class="ayvb-due">{{waiting}}</p>{{/waiting}}
                    {{#due}}<div class="ayvb-due"><span title="{{datetitle}}">{{due}}</span>{{#renew}}<form method="post" action="{{renewaction}}"><input type="hidden" name="sesskey" value="{{sesskey}}"><input type="hidden" name="loan" value="{{loan}}"><input type="hidden" name="returnurl" value="{{back}}"><button type="submit" class="ayvb-renew" title="{{title}}">{{label}}</button></form>{{/renew}}</div>{{/due}}
                </div>
            </li>
            {{/items}}
        </ul>
        {{/hasitems}}
        {{#note}}<p class="ayvb-small">{{note}}</p>{{/note}}
        {{#textbooks}}<p class="ayvb-small">{{textbooks}}</p>{{/textbooks}}
        {{/books}}
        {{#tell}}
        <div class="ayvb-say{{^face}} no-face{{/face}}">
            {{#face}}<img class="ayvb-face" src="{{face}}" alt="">{{/face}}
            <div><h3 class="ayvb-h">{{heading}}</h3>{{#line}}<p class="ayvb-line">{{line}}</p>{{/line}}</div>
        </div>
        {{#pick}}
        <div class="ayvb-pick">
            {{#cover}}{{#img}}<span class="ayvb-cover md"><img src="{{img}}" alt=""></span>{{/img}}{{^img}}<span class="ayvb-cover md drawn {{drawn}}"><i>{{title}}</i></span>{{/img}}{{/cover}}
            <div class="ayvb-pick-txt">
                <a class="ayvb-title" href="{{url}}">{{title}}</a>
                {{#author}}<span class="ayvb-author">{{author}}</span>{{/author}}
                <span class="ayvb-state {{#ok}}ok{{/ok}}{{^ok}}short{{/ok}}">{{state}}</span>
                <span class="ayvb-pick-do"><a class="btn ayvb-btn ayvb-btn-sm" href="{{url}}">{{label}}</a></span>
            </div>
        </div>
        {{/pick}}
        {{#search}}<p class="ayvb-pick-do"><a class="btn ayvb-btn ayvb-btn-sm" href="{{url}}">{{label}}</a></p>{{/search}}
        {{#shelf}}
        <div class="ayvb-shelf"><div class="ayvb-shelf-row">
            {{#books}}<a href="{{url}}" title="{{title}}" aria-label="{{title}}">{{#cover}}{{#img}}<span class="ayvb-cover"><img src="{{img}}" alt=""></span>{{/img}}{{^img}}<span class="ayvb-cover drawn {{drawn}}"><i>{{title}}</i></span>{{/img}}{{/cover}}</a>{{/books}}
        </div></div>
        <div class="ayvb-shelf-do"><a class="ayvb-more" href="{{more}}">{{morelabel}}</a></div>
        {{/shelf}}
        {{#sign}}<p class="ayvb-sign">{{sign}}</p>{{/sign}}
        {{/tell}}
        {{#challenge}}
        <div class="ayvb-goal-top"><h3 class="ayvb-h">{{heading}}</h3><span class="ayvb-goal-n">{{count}}{{#met}} · {{met}}{{/met}}</span></div>
        <div class="ayvb-marks{{#stars}} stars{{/stars}}" role="img" aria-label="{{count}}">
            {{#marks}}{{#stars}}<svg viewBox="0 0 24 24" aria-hidden="true"><path class="{{#on}}on{{/on}}{{^on}}off{{/on}}" d="M12 2.8l2.3 6.9 6.9 2.3-6.9 2.3L12 21.2l-2.3-6.9L2.8 12l6.9-2.3z"/></svg>{{/stars}}{{^stars}}<svg viewBox="0 0 24 24" aria-hidden="true"><path class="{{#on}}on{{/on}}{{^on}}off{{/on}}" d="M4.5 19.5C4.5 10.6 10.4 4.7 19.8 4.2c-.4 9.4-6.3 15.3-15.3 15.3z"/>{{#on}}<path d="M5.5 18.5 14 10" fill="none" stroke="rgba(255,255,255,.55)" stroke-width="1.3" stroke-linecap="round"/>{{/on}}</svg>{{/stars}}{{/marks}}
        </div>
        <p class="ayvb-small">{{text}}</p>
        {{#meton}}<p class="ayvb-small">{{meton}}</p>{{/meton}}
        {{/challenge}}
        {{#goal}}
        <div class="ayvb-goal-top"><h3 class="ayvb-h">{{heading}}</h3><span class="ayvb-goal-n">{{count}}{{#met}} · {{met}}{{/met}}</span></div>
        <div class="ayvb-bar ayvb-bar-{{steps}}" role="img" aria-label="{{count}}">{{#bar}}<i{{#on}} class="on"{{/on}}></i>{{/bar}}</div>
        <p class="ayvb-small">{{text}}</p>
        {{/goal}}
        {{#readings}}
        <h3 class="ayvb-h">{{heading}}</h3>
        <ul class="ayvb-reads">
            {{#rows}}
            <li class="ayvb-read">
                {{#cover}}{{#img}}<span class="ayvb-cover xs"><img src="{{img}}" alt=""></span>{{/img}}{{^img}}<span class="ayvb-cover xs drawn {{drawn}}"><i>{{title}}</i></span>{{/img}}{{/cover}}
                <div class="ayvb-read-txt"><a class="ayvb-title" href="{{url}}">{{title}}</a><span class="ayvb-course">{{course}}</span>
                    <span class="ayvb-state {{#ok}}ok{{/ok}}{{^ok}}short{{/ok}}">{{state}}</span></div>
            </li>
            {{/rows}}
        </ul>
        {{#more}}<a class="ayvb-more" href="{{more}}">{{morelabel}}</a>{{/more}}
        {{/readings}}
        {{#moments}}
        <div class="ayvb-say{{^face}} no-face{{/face}}">
            {{#face}}<img class="ayvb-face" src="{{face}}" alt="">{{/face}}
            <div><h3 class="ayvb-h">{{heading}}</h3>
                <ul class="ayvb-moments">{{#items}}<li>{{#url}}<a href="{{url}}">{{text}}</a>{{/url}}{{^url}}{{text}}{{/url}}</li>{{/items}}</ul>
            </div>
        </div>
        {{/moments}}
        {{#pulse}}
        <h3 class="ayvb-h">{{heading}}</h3>
        <ul class="ayvb-counts">
            {{#rows}}<li><a href="{{url}}"><b>{{number}}</b><span>{{label}}</span></a></li>{{/rows}}
        </ul>
        {{#line}}<p class="ayvb-small">{{line}}</p>{{/line}}
        {{/pulse}}
    </section>
    {{/sections}}
</div>
{{/centres}}
<div class="ayvb ayvb-end skin-{{skin}}" data-ayvb>
    <div class="ayvb-actions">
        <a class="btn ayvb-btn{{^gofirst}} ayvb-btn-quiet{{/gofirst}}" href="{{home}}">{{golabel}}</a>
        {{#card}}<a class="btn ayvb-btn ayvb-btn-quiet" href="{{card}}">{{#leaf}}<svg viewBox="0 0 24 24" aria-hidden="true"><path d="M12 21v-8" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"/><path d="M12 14c-4.5 0-6.5-2.6-6.5-6 3.6 0 6.5 2 6.5 6zM12 12c0-4 2.4-6.5 6.5-6.5 0 3.8-2.4 6.5-6.5 6.5z" fill="currentColor"/></svg>{{/leaf}}{{#star}}<svg viewBox="0 0 24 24" aria-hidden="true"><path d="M12 2.5l2.2 7.3 7.3 2.2-7.3 2.2L12 21.5l-2.2-7.3L2.5 12l7.3-2.2z" fill="currentColor"/></svg>{{/star}}{{cardlabel}}</a>{{/card}}
    </div>
</div>
</div>
