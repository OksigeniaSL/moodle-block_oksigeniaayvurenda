{{!
    @template block_oksigeniaayvurenda/content

    What a reader has in the library, and the ways in.

    Example context (json):
    {
        "loansheading": "Tus libros", "holdsheading": "Apartados o en camino", "none": "No tienes libros prestados.",
        "golibrarylabel": "Ir a la biblioteca", "cardlabel": "Mi carné", "springlabel": "Ayvu rande",
        "libraries": [{"name": "Biblioteca", "showname": false, "home": "#", "card": "#", "spring": "#",
            "hasloans": true, "loans": [{"title": "El faro dormido", "url": "#", "when": "hasta el 3 nov", "late": false}],
            "hasholds": true, "holds": [{"title": "La sal del mar", "url": "#", "when": "te espera hasta el 30 oct", "ready": true}]}],
        "hasvisits": false, "visits": [], "desklabel": "Mostrador"
    }
}}
<div class="block-oksigeniaayvurenda">
{{#libraries}}
    {{#showname}}<p class="block-oksigeniaayvurenda-name">{{name}}</p>{{/showname}}
    <p class="block-oksigeniaayvurenda-heading">{{loansheading}}</p>
    {{^hasloans}}<p class="block-oksigeniaayvurenda-none">{{none}}</p>{{/hasloans}}
    {{#hasloans}}
    <ul class="block-oksigeniaayvurenda-list">
        {{#loans}}<li{{#late}} class="block-oksigeniaayvurenda-late"{{/late}}><a href="{{url}}">{{title}}</a> <span>{{when}}</span></li>{{/loans}}
    </ul>
    {{/hasloans}}
    {{#hasholds}}
    <p class="block-oksigeniaayvurenda-heading">{{holdsheading}}</p>
    <ul class="block-oksigeniaayvurenda-list">
        {{#holds}}<li{{#ready}} class="block-oksigeniaayvurenda-ready"{{/ready}}><a href="{{url}}">{{title}}</a> <span>{{when}}</span></li>{{/holds}}
    </ul>
    {{/hasholds}}
    <p class="block-oksigeniaayvurenda-links"><a class="btn btn-primary btn-sm" href="{{home}}">{{golibrarylabel}}</a>
        <a class="btn btn-secondary btn-sm" href="{{card}}">{{cardlabel}}</a>
        <a class="btn btn-secondary btn-sm" href="{{spring}}">{{springlabel}}</a></p>
{{/libraries}}
{{#hasvisits}}
    {{#visits}}
    <p class="block-oksigeniaayvurenda-name">{{name}}</p>
    <p class="block-oksigeniaayvurenda-links"><a class="btn btn-primary btn-sm" href="{{home}}">{{golibrarylabel}}</a>
        {{#desk}}<a class="btn btn-secondary btn-sm" href="{{desk}}">{{desklabel}}</a>{{/desk}}</p>
    {{/visits}}
{{/hasvisits}}
</div>
